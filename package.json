{
  "name": "wirewise",
  "version": "1.0.0",
  "description": "Interactive real-time electrical installation modeler, circuit simulator, and code compliance planner (PEC 2017 & IEC 60364).",
  "author": "John Ray O. Dalida",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/jro-d/wirewise.git"
  },
  "scripts": {
    "dev": "vite",
    "check:catalog": "node scripts/check-catalog.mjs",
    "build": "node scripts/check-catalog.mjs && tsc && vite build",
    "desktop:icons": "node scripts/generate-icons.mjs",
    "desktop:dev": "tauri dev",
    "desktop:build": "npm run desktop:icons && tauri build --bundles nsis",
    "tauri": "tauri",
    "preview": "vite preview",
    "test": "node tests/run-all.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.7.0",
    "esbuild": "^0.25.12",
    "lucide-react": "^1.77.0",
    "postcss": "^8.5.33",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
